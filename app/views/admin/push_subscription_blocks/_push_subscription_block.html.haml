%tr
  %td.nowrap
    %samp= push_subscription_block.name
  %td.wrap
    %samp= push_subscription_block.endpoint
  %td.nowrap
    - if push_subscription_block.enable?
      %span.positive-hint
        = material_symbol 'check'
        = ' '
        = t 'admin.push_subscription_blocks.enabled'
    - else
      %span.negative-hint
        = material_symbol 'cancel'
        = ' '
        = t 'admin.push_subscription_blocks.disabled'
  %td.nowrap.align-end
    - if push_subscription_block.enable?
      = link_to material_symbol('power_off'), disable_admin_push_subscription_block_path(push_subscription_block), title: t('admin.push_subscription_blocks.disable'), method: :post, data: { confirm: t('admin.accounts.are_you_sure') }, class: 'table-icon-link'
    - else
      = link_to material_symbol('power_off'), enable_admin_push_subscription_block_path(push_subscription_block), title: t('admin.push_subscription_blocks.enable'), method: :post, data: { confirm: t('admin.accounts.are_you_sure') }, class: 'table-icon-link'

    = link_to material_symbol('edit'), edit_admin_push_subscription_block_path(push_subscription_block), title: t('admin.push_subscription_blocks.edit.title'), class: 'table-icon-link'
    = link_to material_symbol('delete'), admin_push_subscription_block_path(push_subscription_block), title: t('admin.push_subscription_blocks.delete'), method: :delete, data: { confirm: t('admin.accounts.are_you_sure') }, class: 'table-icon-link table-icon-link--danger'
